{
  "name": "volaris",
  "version": "1.2.0",
  "private": true,
  "description": "Volaris monorepo: high-performance disk analyzer.",
  "type": "module",
  "scripts": {
    "app:dev": "pnpm --filter @volaris/app run dev",
    "app:build": "pnpm --filter @volaris/app run build",
    "app:pack": "pnpm --filter @volaris/app run pack",
    "app:dist": "pnpm --filter @volaris/app run dist",
    "app:dist:dev": "pwsh -NoProfile -File packages/app/scripts/build-dev-signed.ps1",
    "build:native": "pnpm --filter @volaris/native build",
    "test": "node --test",
    "start": "pnpm --filter @volaris/cli start",
    "scan:d": "pnpm --filter @volaris/cli scan:d",
    "scan:json": "pnpm --filter @volaris/cli scan:json",
    "scan:csv": "pnpm --filter @volaris/cli scan:csv",
    "dev:cli": "pnpm --filter @volaris/cli start",
    "link:cli": "cd packages/cli && pnpm link --global",
    "pack:cli": "cd packages/cli && pnpm pack"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.1"
}
