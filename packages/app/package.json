{
  "name": "@volaris/app",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Volaris Windows 磁盘空间分析桌面端",
  "author": "Volaris",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && electron-vite build",
    "pack": "pnpm build && electron-builder --config electron-builder.cjs --dir --win --x64 --publish never",
    "dist": "pnpm build && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@volaris/core": "workspace:*",
    "@volaris/shared": "workspace:*",
    "d3-hierarchy": "^3.1.3",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
