{
  "name": "@volaris/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "volaris": "./src/index.js"
  },
  "scripts": {
    "start": "node ./src/index.js --path D:\\\\",
    "scan:d": "node ./src/index.js --path D:\\\\ --top 50",
    "scan:json": "node ./src/index.js --path D:\\\\ --format json",
    "scan:csv": "node ./src/index.js --path D:\\\\ --format csv"
  },
  "dependencies": {
    "@volaris/core": "workspace:*",
    "@volaris/shared": "workspace:*",
    "chalk": "^5.6.0",
    "cli-progress": "^3.12.0",
    "minimist": "^1.2.8"
  }
}